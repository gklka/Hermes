<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Needed for communication notifications (sender pictures). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<!-- messengermac://share?id=… : the share extension handing over what to send (ShareHandoff). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kristofgruber.MessengerMac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>messengermac</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
