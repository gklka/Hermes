<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group shared with the share extension (ShareHandoff; Support/Signing.xcconfig). -->
	<key>MMAppGroupID</key>
	<string>$(APP_GROUP_ID)</string>
	<!-- Merged into the generated Info.plist. Needed for communication notifications (sender pictures). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<!-- hermes://share?id=… : the share extension handing over what to send (ShareHandoff). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hermes</string>
			</array>
		</dict>
	</array>
	<!-- Show Contact Card: finding the person of a chat among your contacts (ContactCards). -->
	<key>NSContactsUsageDescription</key>
	<string>Hermes finds the people you chat with in your contacts to show their contact cards.</string>
	<!-- Audio and video calls (CallManager). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Hermes uses the microphone for Messenger calls.</string>
	<key>NSCameraUsageDescription</key>
	<string>Hermes uses the camera for Messenger video calls.</string>
	<!-- Updates (Sparkle): the latest GitHub release's appcast.xml (Support/release-appcast.sh).
	     Its private key is in the login Keychain of the machine that made it (generate_keys). -->
	<key>SUFeedURL</key>
	<string>https://github.com/gklka/Hermes/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>psMth31tnZptpHYG1FSSJPD/sdHMmisNWLAStBth+pE=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
