<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the share extension (ShareHandoff). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
	<!-- The hardened runtime (needed for notarization) allows these only when asked for:
	     calls (CallManager) and contact cards (ContactCards). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- Notifications with the sender's picture, badged with the app icon (Notifier). Needs a
	     provisioning profile, so a paid team; with a free one, remove it. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
